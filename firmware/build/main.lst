 104:Core/Src/main.c ****     tp_init(); // Инициализация тачпада
 105:Core/Src/main.c **** 
 106:Core/Src/main.c ****     while (1) {
 107:Core/Src/main.c ****         // ===== СКАНИРУЕМ МАТРИЦУ =====
 108:Core/Src/main.c ****         uint8_t count = keyboard_scan(current_keys, 6);
 109:Core/Src/main.c ****         uint8_t need_send = 0;
 110:Core/Src/main.c **** 
 111:Core/Src/main.c ****         // Где-то в keyboard_scan() или после него:
 112:Core/Src/main.c ****         if (fn_pressed) {
 113:Core/Src/main.c ****             // Проверяем, нажаты ли F5 или F6
 114:Core/Src/main.c ****             for (int i = 0; i < count; i++) {
 115:Core/Src/main.c ****                 if (current_keys[i] == KEY_F5) {
 116:Core/Src/main.c **** 
 117:Core/Src/main.c ****                     // Volume Down
 118:Core/Src/main.c ****                     USBD_HID_SendMedia(&hUsbDeviceFS, 0x02);
 119:Core/Src/main.c ****                     HAL_Delay(100);
 120:Core/Src/main.c ****                     USBD_HID_SendMedia(&hUsbDeviceFS, 0x00); // Отпустить
 121:Core/Src/main.c ****                     current_keys[i] = 0; // Убираем F5 из обычного отчёта
 122:Core/Src/main.c ****                 } else if (current_keys[i] == KEY_F6) {
 123:Core/Src/main.c ****                     // Volume Up
 124:Core/Src/main.c ****                     USBD_HID_SendMedia(&hUsbDeviceFS, 0x01);
 125:Core/Src/main.c ****                     HAL_Delay(100);
 126:Core/Src/main.c ****                     USBD_HID_SendMedia(&hUsbDeviceFS, 0x00); // Отпустить
 127:Core/Src/main.c ****                     current_keys[i] = 0; // Убираем F6 из обычного отчёта
 128:Core/Src/main.c ****                 } else if (current_keys[i] == KEY_F2) {
 129:Core/Src/main.c ****                     // Volume Mute
 130:Core/Src/main.c ****                     USBD_HID_SendMedia(&hUsbDeviceFS, 0x04);
 131:Core/Src/main.c ****                     HAL_Delay(100);
 132:Core/Src/main.c ****                     USBD_HID_SendMedia(&hUsbDeviceFS, 0x00); // Отпустить
 133:Core/Src/main.c ****                     current_keys[i] = 0; // Убираем F6 из обычного отчёта
 134:Core/Src/main.c ****                 }
 135:Core/Src/main.c ****             }
 136:Core/Src/main.c ****         }
 137:Core/Src/main.c **** 
 138:Core/Src/main.c ****         // ===== 1. ПРОВЕРЯЕМ МОДИФИКАТОРЫ (ОТДЕЛЬНО!) =====
 139:Core/Src/main.c ****         if (current_modifiers != last_modifiers) {
 140:Core/Src/main.c ****             need_send = 1;
 141:Core/Src/main.c ****             last_modifiers = current_modifiers;
 142:Core/Src/main.c ****         }
 143:Core/Src/main.c **** 
 144:Core/Src/main.c ****         // ===== 2. ПРОВЕРЯЕМ КЛАВИШИ =====
 145:Core/Src/main.c ****         for (int i = 0; i < 6; i++) {
 146:Core/Src/main.c ****             if (current_keys[i] != last_keys[i]) {
 147:Core/Src/main.c ****                 need_send = 1;
ARM GAS  /tmp/cc2J9ZTK.s 			page 4


 148:Core/Src/main.c ****                 last_keys[i] = current_keys[i];
 149:Core/Src/main.c ****             }
 150:Core/Src/main.c ****         }
 151:Core/Src/main.c **** 
 152:Core/Src/main.c ****         // ===== 3. ОТПРАВЛЯЕМ, ЕСЛИ ЕСТЬ ИЗМЕНЕНИЯ =====
 153:Core/Src/main.c ****         if (need_send) {
 154:Core/Src/main.c ****             keyboard_build_report(current_keys, count, report);
 155:Core/Src/main.c ****             USBD_HID_SendKeyboard(&hUsbDeviceFS, report, 9);
 156:Core/Src/main.c ****         }
 157:Core/Src/main.c ****         // ===== 4. ЕСЛИ ВСЁ ОТПУЩЕНО — ОДИН ПУСТОЙ ОТЧЁТ =====
 158:Core/Src/main.c ****         else if (count == 0 && current_modifiers == 0) {
 159:Core/Src/main.c ****             static uint8_t empty_sent = 0;
 160:Core/Src/main.c ****             if (!empty_sent) {
 161:Core/Src/main.c ****                 uint8_t empty[9] = { 0 };
 162:Core/Src/main.c ****                 empty[0] = 0x01;
 163:Core/Src/main.c ****                 USBD_HID_SendKeyboard(&hUsbDeviceFS, empty, 9);
 164:Core/Src/main.c ****                 empty_sent = 1;
 165:Core/Src/main.c ****             }
 166:Core/Src/main.c ****         } else {
 167:Core/Src/main.c ****             empty_sent = 0;
 168:Core/Src/main.c ****         }
 169:Core/Src/main.c **** 
 170:Core/Src/main.c ****         HAL_Delay(10);
 171:Core/Src/main.c **** 
 172:Core/Src/main.c ****         tp_process();
 173:Core/Src/main.c ****         HAL_Delay(10);
 174:Core/Src/main.c ****     }
 175:Core/Src/main.c **** }
